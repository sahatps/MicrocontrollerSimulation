// Responsive design for tablets
@media screen and (max-width: 1024px)
    main
        .controlBar
            width var(--controlbar-width)
            min-width 0

            .buttonBar
                button
                    padding 5px 10px
                    font-size 13px

            textarea
                min-height 100px
                font-size 12px

// Responsive design for mobile devices
@media screen and (max-width: 768px)
    main
        flex-direction column

        .controlBar
            width var(--controlbar-width)
            min-width 0
            height auto
            border-left none
            border-top 1px solid black

            .controlbar-topright
                top 6px
                right 8px
                gap 4px

            .controlbar-topright-row
                gap 6px

            .controlbar-select-corner
                min-width 100px
                max-width 150px
                font-size 11px

            .examples-mode-corner
                min-width 0
                max-width none

            .tab-bar
                margin-top 0

            label
                font-size 13px
                margin-top 8px

            textarea
                min-height 80px
                font-size 12px

            .buttonBar
                flex-direction row
                flex-wrap wrap
                gap 5px

                p
                    font-size 13px
                    width 100%

                button
                    padding 5px 8px
                    font-size 12px
                    width auto
                    flex 1
                    min-width 60px

                select
                    font-size 12px
                    padding 5px 8px

            .buttonBar.run-controls
                flex-direction column
                align-items stretch

                .run-controls-row
                    flex-wrap nowrap
                    gap 0

                .run-circle-btn
                    width 40px
                    height 40px
                    min-width 40px
                    flex 0 0 auto

                .sim-http-toggle-btn
                    width 34px
                    min-width 34px
                    height 40px
                    font-size 18px

                .session-circle-btn
                    width 200px
                    min-width 40px
                    height 200px

                .sim-http-settings
                    width 280px

        #hackCable
            height 50vh
            overflow auto

body.controlbar-resizing
    #hackCable
        transition none

    .controlBar
        transition none

// Responsive design for small mobile devices
@media screen and (max-width: 480px)
    header
        display none

    main
        padding-top 0

        .controlBar
            padding 52px 8px 8px

            label
                font-size 12px

            textarea
                min-height 60px
                font-size 11px
                padding 6px

            .buttonBar
                gap 4px

                p
                    font-size 12px

                button
                    padding 6px 8px
                    font-size 11px

                select
                    font-size 11px
                    padding 6px 8px

            .buttonBar.run-controls
                .run-controls-row
                    flex-wrap nowrap
                    gap 0

                .run-circle-btn
                    width 36px
                    height 36px
                    min-width 36px
                    outline-width 3px

                .sim-http-toggle-btn
                    width 30px
                    min-width 30px
                    height 36px
                    font-size 16px

                .session-circle-btn
                    width 36px
                    min-width 36px
                    height 36px

                .sim-http-settings
                    width 240px


// Control bar toggle button — always fixed to right edge, independent of controlBar state
.toggle-controlbar
    display none !important
    position fixed
    right 0
    top 50%
    transform translateY(-50%)
    background-color #30343F
    color white
    border 1px solid #555
    border-right none
    border-radius 5px 0 0 5px
    padding 10px 6px
    cursor pointer
    display flex
    align-items center
    justify-content center
    z-index 9999
    transition background-color 0.2s

    &:hover
        background-color #4a4e5a

    .toggle-icon
        font-size 12px
        font-weight bold
        transition transform 0.2s

    &.panel-open
        .toggle-icon
            transform rotate(180deg)
