p, h1, h2, h3, h4, select, label
    font-family Rubik
    color white

html
    min-height 100vh

body
    margin 0
    padding 0
    min-height 100vh
    position relative
    --controlbar-width 340px

header
    display none


main
    box-sizing: border-box
    padding-top 0
    padding-bottom 20px;
    height 100vh
    overflow hidden
    display flex
    flex-direction row

.sideBar, .hackCable-sideBar
    background-color #30343F
    max-width 500px
    min-width 300px
    width 40%
    height 100%
    border-right 1px solid black
    padding 10px
    display flex
    flex-direction column
    overflow-y auto
    overflow-x visible
    transition width 0.3s ease, min-width 0.3s ease
    position relative

    .toggle-sidebar
        border none
        border-radius 5px
        padding 6px 10px
        cursor pointer
        transition all 0.2s
        font-size 14px
        background-color white
        color black
        min-width 40px
        min-height 32px
        display flex
        align-items center
        justify-content center
        position absolute
        top 10px
        left 10px
        z-index 100

        &:hover
            background-color #e0e0e0

        .toggle-icon
            font-size 12px
            font-weight bold
            transition transform 0.2s

        &.sidebar-hidden
            position fixed
            background-color #30343F
            color white
            border 1px solid black
            left 10px
            top 50px

            &:hover
                background-color #3a3e4a

            .toggle-icon
                transform rotateY(180deg)

    .buttonBar
        select
            border none
            border-radius 5px
            padding 6px 12px
            background-color white
            color black
            cursor pointer
            font-size 14px
            min-width 150px

            option
                color black

    &.hidden
        width 0
        min-width 0
        max-width 0
        padding 0
        border-right none
        overflow hidden

    .hackCable-catalog-actions
        display flex
        flex-direction row
        margin-bottom 10px
        gap 10px
        flex-wrap wrap
        line-height 0
        align-items center

        select
            border none
            border-radius 5px
            padding 6px 12px
            background-color white
            color black
            cursor pointer
            font-size 14px
            min-width 150px
            flex 1

            option
                color black

    .hackCable-toggle-sidebar
        border none
        border-radius 5px
        padding 6px 10px
        cursor pointer
        transition all 0.2s
        font-size 14px
        background-color white
        color black
        min-width 40px
        min-height 32px
        display flex
        align-items center
        justify-content center
        position absolute
        top 10px
        left 10px
        z-index 100

        &:hover
            background-color #e0e0e0

        .toggle-icon
            font-size 12px
            font-weight bold
            transition transform 0.2s

        &.sidebar-hidden
            background-color #30343F
            color white
            border 1px solid black
            left 0
            top 50px

            &:hover
                background-color #3a3e4a

            .toggle-icon
                transform rotateY(180deg)

        .buttonBar
            display flex
            flex-direction row
            margin-bottom 10px
            gap 10px
            flex-wrap wrap
            line-height 0
            align-items center

            p
                margin 0
                white-space nowrap

            button
                border none
                border-radius 5px
                padding 6px 12px
                cursor pointer
                transition background-color 0.2s
                font-size 14px

                &:hover
                    background-color #e0e0e0

            select
                border none
                border-radius 5px
                padding 6px 12px
                background-color white
                color black
                cursor pointer
                font-size 14px
                min-width 150px

                option
                    color black

        .status-message
            padding 8px 12px
            margin-top 10px
            margin-bottom 10px
            border-radius 5px
            font-size 14px
            font-weight 500
            text-align center
            transition all 0.3s ease

            &.status-info
                background-color #2196F3
                color white

            &.status-success
                background-color #4CAF50
                color white

            &.status-error
                background-color #f44336
                color white

            &.wiring-validation-status
                max-height 220px
                overflow-y auto
                text-align left
                line-height 1.45

                strong
                    display block
                    margin-bottom 6px

                ul
                    margin 0
                    padding-left 22px

                li + li
                    margin-top 4px

        label
            display block
            margin-top 10px
            margin-bottom 5px
            font-size 14px

        textarea
            border none
            border-radius 5px
            width 100%
            resize vertical
            min-height 150px
            padding 8px
            font-family monospace
            font-size 13px
            box-sizing border-box

    #hackCable
        flex 1
        overflow auto
        background-color #f5f5f5
        margin-right var(--controlbar-width)
        transition margin-right 0.3s ease

body.controlbar-hidden #hackCable
    margin-right 0

.controlBar
    position fixed
    right 0
    top 0
    bottom 20px
    width var(--controlbar-width)
    background-color #77af5a
    border-left 1px solid #5f9447
    padding 56px 10px 10px
    display flex
    flex-direction column
    gap 6px
    overflow-x hidden
    overflow-y auto
    -ms-overflow-style none
    scrollbar-width none
    transition width 0.3s ease, padding 0.3s ease
    box-sizing border-box
    z-index 1000

    &::-webkit-scrollbar
        width 0
        background transparent

    &.hidden
        width 0
        padding 0
        border-left none
        overflow hidden

    .controlbar-resize-handle
        position absolute
        left 0
        top 0
        bottom 0
        width 10px
        transform translateX(-50%)
        cursor ew-resize
        z-index 1003

    &.hidden .controlbar-resize-handle
        display none

    .controlbar-topright
        position absolute
        top 8px
        right 10px
        display flex
        flex-direction column
        align-items flex-end
        gap 6px
        z-index 1002

    .controlbar-topright-row
        width 100%
        display flex
        align-items center
        justify-content flex-end
        gap 8px

    .controlbar-select-corner
        width auto
        min-width 120px
        max-width 170px
        padding 0
        border none
        outline none
        background transparent
        color #f4fff0
        font-size 0.9rem
        font-weight 600
        line-height 1.2
        cursor pointer
        transition color 0.2s

        &:hover
            color white

        option
            color #111
            background #fff

            &:disabled
                color #8f98a3
                background #eef1ec

    .examples-mode-corner
        width 100%
        min-width 0
        max-width none

    .language-toggle-corner
        width auto
        min-width auto
        padding 0
        border none
        outline none
        background transparent
        color #f4fff0
        font-size 0.9rem
        font-weight 700
        line-height 1
        cursor pointer
        text-align right
        transition color 0.2s

        &:hover
            background transparent
            color white

    .status-message
        padding 8px 12px
        border-radius 5px
        font-size 0.95rem
        font-weight 500
        text-align center
        transition all 0.3s ease

        &:empty
            display none

        &.status-info
            background-color #2196F3
            color white

        &.status-success
            background-color #4CAF50
            color white

        &.status-error
            background-color #f44336
            color white

        &.wiring-validation-status
            max-height 220px
            overflow-y auto
            text-align left
            line-height 1.45

            strong
                display block
                margin-bottom 6px

            ul
                margin 0
                padding-left 22px

            li + li
                margin-top 4px

    .tab-bar
        margin-top 42px

    .wiring-controls,
    .wiring-controls[hidden]
        display none !important

    label
        display block
        margin-top 10px
        margin-bottom 5px
        font-size 0.95rem

    textarea
        border none
        border-radius 5px
        width 100%
        resize vertical
        min-height 120px
        padding 8px
        font-family monospace
        font-size 0.9rem
        box-sizing border-box
        scrollbar-width thin
        scrollbar-color rgba(229, 231, 235, 0.12) transparent

        &::-webkit-scrollbar
            width 8px
            height 8px

        &::-webkit-scrollbar-track
            background transparent

        &::-webkit-scrollbar-thumb
            background rgba(229, 231, 235, 0.12)
            border-radius 10px

        &::-webkit-scrollbar-thumb:hover
            background rgba(229, 231, 235, 0.22)

        &::-webkit-scrollbar-corner
            background transparent

    .buttonBar
        display flex
        flex-direction column
        gap 6px

        p
            margin 0
            white-space nowrap

        button
            border none
            border-radius 5px
            padding 6px 12px
            cursor pointer
            transition background-color 0.2s
            font-size 0.95rem
            background-color white
            color black
            width 100%
            text-align left

            &:hover
                background-color #e0e0e0

        select
            border none
            border-radius 5px
            padding 6px 12px
            background-color white
            color black
            cursor pointer
            font-size 0.95rem
            width 100%

            option
                color black

    .buttonBar.run-controls
        position relative
        flex-direction column
        align-items stretch
        gap 8px

        p
            width 100%
            margin 0

        .run-controls-row
            display flex
            flex-direction row
            flex-wrap nowrap
            align-items center
            justify-content space-between
            gap 0

        .sim-http-toggle-btn
            width 38px
            min-width 38px
            height 44px
            padding 0
            border none
            outline none
            background transparent
            color #d3d7df
            font-size 20px
            line-height 1
            text-align center
            cursor pointer
            flex 0 0 auto
            display flex
            align-items center
            justify-content center
            transition color 0.2s, transform 0.2s

            &:hover
                background transparent
                color white

            &:active
                transform scale(0.95)

            &.active
                color #7dd3fc

            .sim-http-icon
                width 23px
                height 23px
                display block
                fill currentColor

        .session-circle-btn
            font-size 1.2em
            font-weight bold
            outline #ffffff88 4px solid
            border #77af5a 2px solid
            background #ffffff
            border-radius 50%
            overflow hidden
            height 80%
            width 80%
            aspect-ratio 1
            display flex
            justify-content center
            align-items center
            color #77af5a
            cursor pointer
            transition all 0.3s ease

            &:hover:not(:disabled)
                background #77af5a
                color #fff
                outline: #ffffff88 4px solid

            &:active:not(:disabled)
                transform scale(0.95)

            &:disabled
                opacity 0.45
                cursor not-allowed

            .session-action-icon
                width auto
                height auto
                display block
                font-size 40px
                font-weight 400
                line-height 1
                font-variation-settings 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24

        .sim-http-settings
            position absolute
            right 0
            top calc(100% + 6px)
            width 300px
            max-width 320px
            padding 8px
            border 1px solid #4b5563
            border-radius 8px
            background-color rgba(17, 24, 39, 0.95)
            box-shadow 0 10px 24px rgba(0, 0, 0, 0.35)
            gap 6px
            z-index 1010

            &[hidden]
                display none !important

        .run-circle-btn
            font-size 1.2em
            font-weight bold
            outline #ffffff88 4px solid
            border #77af5a 2px solid
            background #ffffff
            border-radius 50%
            overflow hidden
            height 80%
            width 80%
            aspect-ratio 1
            display flex
            justify-content center
            align-items center
            color #77af5a
            cursor pointer
            transition all 0.3s ease

            &:hover:not(:disabled)
                background #77af5a
                color #fff
                outline: #ffffff88 4px solid

            &:active:not(:disabled)
                transform scale(0.95)

            &:disabled
                opacity 0.45
                cursor not-allowed

        #compile.run-circle-btn
            border-color #77af5a
            background-color #ffffff
            color #77af5a    
            outline: #ffffff88 4px solid


            &:hover:not(:disabled)
                background-color #62c8ce
                color #0d7380
                outline-color rgba(150, 228, 233, 0.75)

            &.is-cancel
                border-color #ef6f6c
                background-color #ff8a86
                color #7f1d1d
                outline-color rgba(255, 183, 178, 0.55)

                &:hover:not(:disabled)
                    background-color #f27571
                    color #6b1717
                    outline-color rgba(255, 183, 178, 0.8)

        .run-circle-btn
            .run-btn-icon
                font-size 22px
                line-height 1
                user-select none

        #compile.run-circle-btn
            .icon-cancel
                display none

            &.is-cancel
                .icon-default
                    display none

                .icon-cancel
                    display block

    #sim-http-container
        input
            border none
            border-radius 5px
            padding 6px 10px
            font-size 0.9rem
            font-family monospace
            width 100%
            box-sizing border-box

        #sim-http-send
            text-align center

    #editor-code-mock-container
        gap 0
        margin-top 6px

        .editor-tab-buttons
            display flex
            gap 4px

        .editor-tab-btn
            flex 1
            border none
            border-radius 5px 5px 0 0
            padding 6px 10px
            background-color #a8cd8b
            color #f4fff0
            font-size 1rem
            font-weight 600
            text-align center
            cursor pointer

            &:hover
                background-color #b7d79f

            &.active
                background-color #ffffff
                color #77af5a

        .editor-tab-panel
            display block

            &[hidden]
                display none

            .code-editor-shell
                display flex
                align-items stretch
                position relative
                height 260px
                min-height 220px
                border-radius 0 0 5px 5px
                border 1px solid #3a3f4b
                background-color #1b1d23
                overflow hidden

                .code-editor-actions
                    position absolute
                    top 0
                    right 0
                    z-index 5
                    display flex
                    gap 0 !important

                    button
                        display block
                        margin 0 !important
                        min-width 52px
                        padding 5px 10px
                        border 1px solid #4fa75d
                        border-radius 0
                        background-color rgba(27, 29, 35, 0.92)
                        color #dff4d8
                        font-size 0.78rem
                        font-weight 600
                        cursor pointer
                        transition background-color 0.15s, color 0.15s

                        &:hover
                            background-color #4fa75d
                            color #fff

                        &:focus-visible
                            outline 2px solid #a8cd8b
                            outline-offset 2px

                        &:first-child
                            border-bottom-left-radius 4px

                        &:last-child
                            border-left 0
                            margin-left -1px !important

            &[data-editor-panel="code"] .CodeMirror
                width 100%
                height 100%
                min-height 100%
                background-color #1b1d23
                color #f4efcf
                font-family Consolas, 'Courier New', monospace
                font-size 0.9rem
                line-height 1.6

            &[data-editor-panel="code"] .CodeMirror-gutters
                background-color #16181d
                border-right 1px solid #2b303b

            &[data-editor-panel="code"] .CodeMirror-linenumber
                color #4fa75d

            &[data-editor-panel="code"] .CodeMirror-cursor
                border-left 1px solid #f5f9a6

            &[data-editor-panel="code"] .CodeMirror-scroll
                scrollbar-width thin
                scrollbar-color rgba(229, 231, 235, 0.12) transparent

                &::-webkit-scrollbar
                    width 8px
                    height 8px

                &::-webkit-scrollbar-track
                    background transparent

                &::-webkit-scrollbar-thumb
                    background rgba(229, 231, 235, 0.12)
                    border-radius 10px

                &::-webkit-scrollbar-thumb:hover
                    background rgba(229, 231, 235, 0.22)

                &::-webkit-scrollbar-corner
                    background transparent

            &[data-editor-panel="code"] .CodeMirror-vscrollbar,
            &[data-editor-panel="code"] .CodeMirror-hscrollbar
                scrollbar-width thin
                scrollbar-color rgba(229, 231, 235, 0.12) transparent
                background transparent !important

                &::-webkit-scrollbar
                    width 8px
                    height 8px

                &::-webkit-scrollbar-track
                    background transparent

                &::-webkit-scrollbar-thumb
                    background rgba(229, 231, 235, 0.12)
                    border-radius 10px

                &::-webkit-scrollbar-thumb:hover
                    background rgba(229, 231, 235, 0.22)

                &::-webkit-scrollbar-corner
                    background transparent

            &[data-editor-panel="code"] .CodeMirror-scrollbar-filler,
            &[data-editor-panel="code"] .CodeMirror-gutter-filler
                background transparent !important

            .code-editor-resize-handle
                position absolute
                left 0
                right 0
                // Keep the resize hit area above the horizontal scrollbar.
                bottom 8px
                height 8px
                cursor ns-resize
                z-index 4
                background linear-gradient(to top, rgba(79, 167, 93, 0.25), rgba(79, 167, 93, 0))
                opacity 0.45
                transition opacity 0.2s

                &:hover
                    opacity 0.9

            &[data-editor-panel="mock"]
                border 1px solid #3a3f4b
                border-radius 0 0 5px 5px
                background-color #1b1d23
                padding 10px
                display flex
                flex-direction column
                gap 10px

                &[hidden]
                    display none !important

                .mock-source-toggle
                    display flex
                    gap 6px

                .mock-source-btn
                    border none
                    border-radius 6px
                    background-color #a8cd8b
                    color #f4fff0
                    font-size 0.9rem
                    font-weight 600
                    padding 6px 10px
                    cursor pointer

                    &:hover
                        background-color #b7d79f

                    &.active
                        background-color #ffffff
                        color #77af5a

                .mock-source-panel
                    display flex
                    flex-direction column
                    gap 10px

                    &[hidden]
                        display none !important

                .mock-source-panel[data-mock-source-panel="text"] textarea
                    margin-top 0
                    border-radius 6px
                    min-height 150px
                    background-color #13161d
                    color #f9fafb
                    border 1px solid #2f3644

                .mock-timeline-toolbar
                    display flex
                    justify-content space-between
                    align-items center
                    gap 10px
                    flex-wrap wrap

                .mock-editor-mode-toolbar
                    display flex
                    justify-content flex-end
                    gap 8px

                .mock-editor-mode-btn
                    border 1px solid #3a4355
                    border-radius 6px
                    padding 4px 10px
                    background-color #20283a
                    color #d1d5db
                    font-size 0.9rem
                    font-weight 600
                    cursor pointer

                    &:hover
                        background-color #2b3446

                .mock-graph-editor
                    display flex
                    flex-direction column
                    gap 10px

                    &[hidden]
                        display none !important

                .mock-graph-controls
                    display flex
                    gap 8px
                    flex-wrap wrap
                    align-items flex-end

                .mock-graph-control
                    display inline-flex
                    flex-direction column
                    gap 4px
                    color #e5e7eb
                    font-size 0.9rem
                    font-weight 600

                    select,
                    input
                        min-width 90px
                        border 1px solid #3b4456
                        border-radius 6px
                        background-color #10141c
                        color #f9fafb
                        padding 4px 8px
                        font-size 0.9rem

                .mock-delete-point-btn
                    border 1px solid #6b2f35
                    border-radius 6px
                    background-color #3b1f24
                    color #fecaca
                    font-size 0.9rem
                    font-weight 600
                    padding 5px 10px
                    cursor pointer

                    &:hover:not(:disabled)
                        background-color #4a252d

                    &:disabled
                        opacity 0.45
                        cursor not-allowed

                .mock-graph-canvas-wrap
                    border 1px solid #2f3a4f
                    border-radius 8px
                    background linear-gradient(180deg, #0f172a, #111827)
                    overflow hidden

                .mock-graph-canvas
                    width 100%
                    height 240px
                    display block

                .mock-graph-hint
                    font-size 0.9rem
                    color #a7b0bf

                .mock-timeline-editor
                    &[hidden]
                        display none !important

                .mock-duration-label
                    display inline-flex
                    align-items center
                    gap 8px
                    color #e5e7eb
                    font-size 0.9rem
                    font-weight 600

                    input
                        width 90px
                        border 1px solid #3b4456
                        border-radius 6px
                        background-color #13161d
                        color #f9fafb
                        padding 4px 8px
                        font-size 0.9rem

                .mock-loop-pill
                    border 1px solid #325f88
                    background-color rgba(59, 130, 246, 0.16)
                    color #bfdbfe
                    border-radius 999px
                    padding 4px 10px
                    font-size 0.9rem
                    font-weight 700

                .mock-timeline-tracks
                    display flex
                    flex-direction column
                    gap 10px

                .mock-timeline-track
                    border 1px solid #303848
                    background-color #141922
                    border-radius 8px
                    padding 8px
                    display flex
                    flex-direction column
                    gap 8px

                .mock-timeline-track-header
                    display flex
                    justify-content space-between
                    align-items center
                    gap 10px

                .mock-timeline-track-title
                    margin 0
                    font-size 0.95rem
                    color #f3f4f6
                    font-weight 700

                .mock-timeline-add-btn
                    border 1px solid #3a4355
                    border-radius 6px
                    padding 4px 8px
                    background-color #222938
                    color #d1d5db
                    font-size 0.9rem
                    font-weight 600
                    cursor pointer

                    &:hover
                        background-color #2b3446

                .mock-timeline-track-axis
                    position relative
                    height 28px
                    border-radius 6px
                    background linear-gradient(90deg, #0f172a, #1e293b)
                    border 1px solid #2f3a4f
                    overflow hidden

                .mock-timeline-segment-bar
                    position absolute
                    top 4px
                    bottom 4px
                    border-radius 4px
                    background linear-gradient(90deg, #22d3ee, #0ea5e9)
                    color #082f49
                    font-size 0.9rem
                    font-weight 700
                    display flex
                    align-items center
                    justify-content center
                    padding 0 4px
                    overflow hidden
                    white-space nowrap

                .mock-timeline-segment-list
                    display flex
                    flex-direction column
                    gap 6px

                .mock-timeline-segment-item
                    display grid
                    grid-template-columns repeat(3, minmax(0, 1fr)) auto
                    gap 6px

                    input
                        border 1px solid #3b4456
                        border-radius 6px
                        background-color #10141c
                        color #f9fafb
                        padding 4px 6px
                        font-size 0.9rem

                .mock-timeline-delete-btn
                    border 1px solid #6b2f35
                    border-radius 6px
                    background-color #3b1f24
                    color #fecaca
                    font-size 0.9rem
                    font-weight 600
                    padding 4px 8px
                    cursor pointer

                    &:hover
                        background-color #4a252d

                .mock-timeline-empty
                    font-size 0.9rem
                    color #9ca3af
                    padding 2px 0

                .mock-timeline-error
                    border 1px solid #7f1d1d
                    background-color rgba(127, 29, 29, 0.2)
                    border-radius 6px
                    color #fecaca
                    font-size 0.9rem
                    padding 6px 8px

    #compiled-io-container
        position relative
        gap 0

        &.floating
            position fixed
            left 40px
            top 80px
            width 440px
            height 340px
            max-width calc(100vw - 20px)
            max-height calc(100vh - 20px)
            padding 8px
            border 1px solid #4b5563
            border-radius 8px
            background-color #30343F
            box-shadow 0 12px 28px rgba(0, 0, 0, 0.45)
            resize both
            overflow auto
            z-index 3500
            gap 6px

        .compiled-tab-toolbar
            display flex
            align-items center
            justify-content flex-start
            gap 4px

        .compiled-tab-buttons
            display flex
            flex 1
            min-width 0
            gap 4px

        .compiled-tab-btn
            flex 1
            border none
            border-radius 5px 5px 0 0
            padding 6px 8px
            background-color #a8cd8b
            color #f4fff0
            font-size 1rem
            font-weight 600
            text-align center
            cursor pointer
            min-width 0

            &:hover
                background-color #b7d79f

            &.active
                background-color #ffffff
                color #77af5a

        .compiled-window-actions
            position absolute
            top 36px
            right 8px
            transform none
            display flex
            align-items center
            gap 4px
            margin 0
            z-index 5

        .compiled-window-icon-btn
            border none
            outline none
            background transparent
            color #e5e7eb
            padding 0
            width 26px
            min-width 26px
